{
  "name": "use-effect-graph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "typecheck:analysis": "tsc --project tsconfig.analysis.json",
    "typecheck:app": "tsc --project tsconfig.app.json --noEmit",
    "test:analysis": "node --test analysis/*.test.ts",
    "analysis": "node analysis/run.ts",
    "report": "node analysis/render.ts",
    "report:baseline": "node codeql-graph/render-graph.ts",
    "build:viewer": "vite build --config analysis/viewer/vite.config.ts && vite build --config analysis/viewer/vite.config.ts --mode baseline",
    "typecheck:viewer": "tsc --project tsconfig.viewer.json"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
